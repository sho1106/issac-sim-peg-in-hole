index a4e9c6d9ec..312aecb427 100644
--- a/source/isaaclab_tasks/isaaclab_tasks/direct/factory/factory_env.py
+++ b/source/isaaclab_tasks/isaaclab_tasks/direct/factory/factory_env.py
@@ -51,9 +51,23 @@ class FactoryEnv(DirectRLEnv):
         )
 
         # Set masses and frictions.
-        factory_utils.set_friction(self._held_asset, self.cfg_task.held_asset_cfg.friction, self.scene.num_envs)
-        factory_utils.set_friction(self._fixed_asset, self.cfg_task.fixed_asset_cfg.friction, self.scene.num_envs)
-        factory_utils.set_friction(self._robot, self.cfg_task.robot_cfg.friction, self.scene.num_envs)
+        friction_dr = getattr(self.cfg, "friction_dr_range", None)
+        if friction_dr is not None:
+            # Friction domain randomization: sample one contact friction per env (log-uniform
+            # over [low, high]) and apply the same value to both contacting assets (matches the
+            # fixed-mu eval semantics where held==fixed==mu). Robot kept at nominal.
+            lo, hi = float(friction_dr[0]), float(friction_dr[1])
+            g = torch.Generator(device="cpu").manual_seed(1234)
+            u = torch.rand(self.scene.num_envs, generator=g)
+            mus = torch.exp(u * (torch.log(torch.tensor(hi)) - torch.log(torch.tensor(lo))) + torch.log(torch.tensor(lo)))
+            self._dr_friction_values = mus
+            factory_utils.set_friction_per_env(self._held_asset, mus, self.scene.num_envs)
+            factory_utils.set_friction_per_env(self._fixed_asset, mus, self.scene.num_envs)
+            factory_utils.set_friction(self._robot, self.cfg_task.robot_cfg.friction, self.scene.num_envs)
+        else:
+            factory_utils.set_friction(self._held_asset, self.cfg_task.held_asset_cfg.friction, self.scene.num_envs)
+            factory_utils.set_friction(self._fixed_asset, self.cfg_task.fixed_asset_cfg.friction, self.scene.num_envs)
+            factory_utils.set_friction(self._robot, self.cfg_task.robot_cfg.friction, self.scene.num_envs)
 
     def _init_tensors(self):
         """Initialize tensors once."""
@@ -269,6 +283,10 @@ class FactoryEnv(DirectRLEnv):
         ctrl_target_fingertip_midpoint_pos = self.fingertip_midpoint_pos + pos_actions
         # To speed up learning, never allow the policy to move more than 5cm away from the base.
         fixed_pos_action_frame = self.fixed_pos_obs_frame + self.init_fixed_pos_obs_noise
+        if getattr(self.cfg, "blind_anchor", False):
+            # Blind variant: clip box is anchored at the episode-start fingertip position,
+            # not the hole frame, so no hole information reaches the policy via clipping.
+            fixed_pos_action_frame = self.init_fingertip_anchor
         delta_pos = ctrl_target_fingertip_midpoint_pos - fixed_pos_action_frame
         pos_error_clipped = torch.clip(
             delta_pos, -self.cfg.ctrl.pos_action_bounds[0], self.cfg.ctrl.pos_action_bounds[1]
