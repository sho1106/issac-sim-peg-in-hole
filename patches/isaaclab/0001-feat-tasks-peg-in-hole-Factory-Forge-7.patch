+++ b/source/isaaclab_tasks/isaaclab_tasks/direct/factory/factory_utils.py
@@ -37,6 +37,17 @@ def set_friction(asset, value, num_envs):
     asset.root_physx_view.set_material_properties(materials, env_ids)
 
 
+def set_friction_per_env(asset, values, num_envs):
+    """Set per-env friction (values: tensor/list of length num_envs). Used for friction DR."""
+    materials = asset.root_physx_view.get_material_properties()
+    # materials[..., 0] has shape (num_envs, num_shapes); reshape to (num_envs, 1) to broadcast.
+    v = torch.as_tensor(values, dtype=materials.dtype).reshape(num_envs, 1)
+    materials[..., 0] = v  # Static friction (broadcast over shapes).
+    materials[..., 1] = v  # Dynamic friction.
+    env_ids = torch.arange(num_envs, device="cpu")
+    asset.root_physx_view.set_material_properties(materials, env_ids)
+
+
 def set_body_inertias(robot, num_envs):
     """Note: this is to account for the asset_options.armature parameter in IGE."""
     inertias = robot.root_physx_view.get_inertias()
