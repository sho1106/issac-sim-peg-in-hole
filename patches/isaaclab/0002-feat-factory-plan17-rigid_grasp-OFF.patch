         light_cfg = sim_utils.DomeLightCfg(intensity=2000.0, color=(0.75, 0.75, 0.75))
         light_cfg.func("/World/Light", light_cfg)
 
+    def _author_grasp_weld(self):
+        """plan17: ペグを手先リンクへ固定ジョイントで剛結し、把持内滑り(β_slip)を除去する。
+
+        `clone_environments()` の**前に** env_0 のプリムへ張るので、全 env に複製される。
+        静止相対姿勢は reset の把持配置（`randomize_initial_state` (3) 節）と同じ公称値:
+        ペグ根本フレームは `panda_fingertip_centered` に対し
+        並進 (0, 0, height - fingerpad_length)・回転 Ry(180°)（= reset の flip_z_quat）。
+        これは腕姿勢に依存しない定数なので、物理を1ステップも回さずに確定できる。
+        """
+        import isaacsim.core.utils.stage as stage_utils
+        from pxr import Gf, Usd, UsdPhysics
+
+        if self.cfg_task.name != "peg_insert":
+            raise NotImplementedError(f"rigid_grasp is only derived for peg_insert (got {self.cfg_task.name})")
+
+        stage = stage_utils.get_current_stage()
+
+        parent_path = "/World/envs/env_0/Robot/panda_fingertip_centered"
+        parent_prim = stage.GetPrimAtPath(parent_path)
+        if not parent_prim.IsValid():
+            raise RuntimeError(f"rigid_grasp: parent body not found: {parent_path}")
+
+        # ペグ側の RigidBody プリムを探索（USD 内部構造をハードコードしない）
+        held_root = stage.GetPrimAtPath("/World/envs/env_0/HeldAsset")
+        if not held_root.IsValid():
+            raise RuntimeError("rigid_grasp: /World/envs/env_0/HeldAsset not found")
+        held_body = next((p for p in Usd.PrimRange(held_root) if p.HasAPI(UsdPhysics.RigidBodyAPI)), None)
+        if held_body is None:
+            raise RuntimeError("rigid_grasp: no RigidBodyAPI prim under HeldAsset")
+
+        offset_z = self.cfg_task.held_asset_cfg.height - self.cfg_task.robot_cfg.franka_fingerpad_length
+
+        joint = UsdPhysics.FixedJoint.Define(stage, "/World/envs/env_0/GraspWeld")
+        joint.CreateBody0Rel().SetTargets([parent_prim.GetPath()])
+        joint.CreateBody1Rel().SetTargets([held_body.GetPath()])
+        joint.CreateLocalPos0Attr().Set(Gf.Vec3f(0.0, 0.0, offset_z))
+        joint.CreateLocalRot0Attr().Set(Gf.Quatf(0.0, Gf.Vec3f(0.0, 1.0, 0.0)))  # Ry(180°)
+        joint.CreateLocalPos1Attr().Set(Gf.Vec3f(0.0, 0.0, 0.0))
+        joint.CreateLocalRot1Attr().Set(Gf.Quatf(1.0, Gf.Vec3f(0.0, 0.0, 0.0)))
+        joint.CreateExcludeFromArticulationAttr().Set(True)
+
+        print(f"[rigid_grasp] weld authored: {parent_path} <-> {held_body.GetPath()}  offset_z={offset_z:.6f}")
+
     def _compute_intermediate_values(self, dt):
         """Get values computed from raw tensors. This includes adding noise."""
         # TODO: A lot of these can probably only be set once?
