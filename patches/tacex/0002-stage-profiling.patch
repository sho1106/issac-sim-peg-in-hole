+    # --- [peg-in-hole port 2026-08-03] 論文(arXiv 2411.04776) Table 1 の3段計時 -------------
+    # 論文は height map 生成 / optical / marker を分けて ms/frame を報告するが、実装には計時が無い。
+    # 既定は無効（cuda 同期のコストを払わない）。環境変数 TACEX_STAGE_PROFILE=1 で有効化する。
+    def _stage_tic(self):
+        if not hasattr(self, "_stage_prof"):
+            self._stage_prof = os.environ.get("TACEX_STAGE_PROFILE") == "1"
+            self.stage_times_ms: dict[str, list[float]] = {}
+        if not self._stage_prof:
+            return None
+        torch.cuda.synchronize()
+        return time.perf_counter()
+
+    def _stage_toc(self, key: str, t0):
+        if t0 is None:
+            return
+        torch.cuda.synchronize()
+        self.stage_times_ms.setdefault(key, []).append((time.perf_counter() - t0) * 1000.0)
+
